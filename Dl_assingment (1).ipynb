      "source": [
        "import tensorflow as tf\n",
        "\n",
        "# Load the IMDB dataset\n",
        "# num_words=10000 means we'll only keep the top 10,000 most frequently occurring words\n",
        "# oov_token (out-of-vocabulary) will be used for words not in the top 10,000\n",
        "(train_data, train_labels), (test_data, test_labels) = tf.keras.datasets.imdb.load_data(num_words=10000, oov_token='<unk>')\n",
        "\n",
        "print(f\"Training entries: {len(train_data)}, labels: {len(train_labels)}\")\n",
        "print(f\"Test entries: {len(test_data)}, labels: {len(test_labels)}\")\n",
        "\n",
        "# Get the word index mapping\n",
        "word_index = tf.keras.datasets.imdb.get_word_index()\n",
        "\n",
        "# The first indices are reserved\n",
        "word_index = {k:(v+3) for k,v in word_index.items()}\n",
        "word_index[\"<pad>\"] = 0\n",
        "word_index[\"<start>\"] = 1\n",
        "word_index[\"<unk>\"] = 2  # OOV token\n",
        "word_index[\"<unused>\"] = 3\n",
        "\n",
        "reverse_word_index = dict([(value, key) for (key, value) in word_index.items()])\n",
        "\n",
        "def decode_review(text):\n",
        "    return ' '.join([reverse_word_index.get(i, '?') for i in text])\n",
        "\n",
        "# Display a sample review and its label\n",
        "print(f\"\\nSample Training Review (encoded): {train_data[0][:50]}...\")\n",
        "print(f\"Sample Training Review (decoded): {decode_review(train_data[0])[:200]}...\")\n",
        "print(f\"Sample Training Label: {'Positive' if train_labels[0] == 1 else 'Negative'}\")\n",
        "\n",
        "print(f\"\\nMaximum review length in training data: {max(len(review) for review in train_data)}\")\n",
        "print(f\"Minimum review length in training data: {min(len(review) for review in train_data)}\")"
      ]
    }
